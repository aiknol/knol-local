{
  "name": "knol-local",
  "version": "0.2.3",
  "description": "Lightweight local memory layer for AI assistants — MCP server + HTTP API + CLI, backed by SQLite + FTS5. Works with Claude, Cursor, and Codex.",
  "type": "module",
  "bin": {
    "knol-local": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "memory",
    "claude",
    "cursor",
    "codex",
    "sqlite",
    "fts5",
    "local",
    "ai-assistant",
    "ai-memory",
    "llm",
    "model-context-protocol",
    "knol"
  ],
  "license": "MIT",
  "homepage": "https://github.com/aiknol/knol-local#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiknol/knol-local.git"
  },
  "bugs": {
    "url": "https://github.com/aiknol/knol-local/issues"
  },
  "author": "aiknol",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
